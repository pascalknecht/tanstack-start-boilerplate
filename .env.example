# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# ── Docker ───────────────────────────────────────────────
# Set to "1" for container/runtime-specific logic if needed by your app
# DOCKER=1
# Stable host ports used by docker-compose.dev.yml
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# ── Database ─────────────────────────────────────────────
# Matches the postgres service in docker-compose.dev.yml.
# For managed databases in production, append ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notilearn

# ── Better Auth ──────────────────────────────────────────
# Generate a secret with: pnpm --filter @repo/web exec auth secret
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ── Misc ────────────────────────────────────────────────
# App URL (used by app/client code as needed)
VITE_PUBLIC_APP_URL=http://localhost:3000
