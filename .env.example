# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# ── Docker ───────────────────────────────────────────────
# Set to "1" for container/runtime-specific logic if needed by your app
# DOCKER=1
# Stable host ports used by docker-compose.dev.yml
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# ── Database ─────────────────────────────────────────────
# Matches the postgres service in docker-compose.dev.yml.
# For managed databases in production, append ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notilearn
# Used by `pnpm test:integration` (created and migrated automatically).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/notilearn_test

# ── Tenancy ──────────────────────────────────────────────
# Apex domain of the platform. `<slug>.APP_ROOT_DOMAIN` serves a tenant, the
# apex and `www.` serve the marketing site. In development `acme.localhost`
# resolves to 127.0.0.1 in all modern browsers, so no /etc/hosts entry is needed.
# Production: notilearn.com (with a wildcard *.notilearn.com domain on Vercel).
APP_ROOT_DOMAIN=localhost

# ── Better Auth ──────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Public URL of the root site. Its protocol and port are applied to tenant
# hosts, and it is the fallback when a request host cannot be resolved.
BETTER_AUTH_URL=http://localhost:3000

# ── Notion (course import, later phases) ─────────────────
# Public integration from https://www.notion.so/profile/integrations
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback
# 32-byte key (base64) used to encrypt Notion access tokens at rest.
# Generate with: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=

# ── Storage (imported course media, later phases) ────────
# Vercel Blob read/write token.
# BLOB_READ_WRITE_TOKEN=

# ── Custom domains (later phases) ────────────────────────
# Used to add/verify tenant domains through the Vercel Domains API.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# ── Email (later phases) ─────────────────────────────────
# Until a provider is configured, auth emails (password reset) are logged to the console.
# RESEND_API_KEY=
# EMAIL_FROM="Notilearn <no-reply@notilearn.com>"

# ── Misc ────────────────────────────────────────────────
# App URL (used by app/client code as needed)
VITE_PUBLIC_APP_URL=http://localhost:3000
