{
  "name": "notilearn",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo test",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @repo/web db:generate",
    "db:migrate": "pnpm --filter @repo/web db:migrate",
    "db:studio": "pnpm --filter @repo/web db:studio"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=26.0.0"
  }
}
